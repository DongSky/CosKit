{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CosKit",
  "version": "1.0.0-beta.1",
  "identifier": "com.coskit.universal",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CosKit",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "licenses/CosKit-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "vendor/photocraft-retouch/LICENSE": "licenses/PhotoCraft-LICENSE.txt"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {}
}
