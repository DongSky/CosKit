+#[test]
+fn ckpipe_replay_is_atomic_cancellable_and_preserves_new_conversations() {
+    let mut s=session(64,64);
+    s.execute("coskit.project.checkpoint",json!({"label":"base"})).unwrap();
+    let before=s.active().unwrap().doc.clone();
+    let params=json!({"version":"v1","steps":[{"command":"image.adjustments.invert","params":{}}]});
+    let id=job(s.start("coskit.project.replay",params.clone()).unwrap());
+    assert!(s.cancel_job(id));assert_eq!(wait_event(&mut s,id).outcome,JobOutcome::Cancelled);s.join_cancelled_jobs();
