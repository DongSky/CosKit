+#[test]
+fn ckpipe_checkpoint_and_restore_are_background_targeted_and_cancellable() {
+    let mut s=session(64,64);
+    let before=pixels(&s);
+    let rev=s.active().unwrap().revision;
+    let steps=s.active().unwrap().history.past_len();
+    let id=job(s.start("coskit.project.checkpoint",json!({"label":"base"})).unwrap());
+    s.add_document(photocraft_doc::Document::new("Other",photocraft_geom::Size::new(8,8),photocraft_color::ColorMode::Rgb,photocraft_color::SampleType::U8),None);
+    assert!(matches!(wait_event(&mut s,id).outcome,JobOutcome::Done(_)));
+    assert_eq!(s.active_index(),Some(1));
+    assert!(s.active().unwrap().pipeline.is_none());
+    s.set_active(0);
+    assert_eq!(s.active().unwrap().revision,rev,"checkpoint never invalidates full-resolution canvas");
+    assert_eq!(s.active().unwrap().history.past_len(),steps);
+    let pipeline=s.active().unwrap().pipeline.clone();
+    let id=job(s.start("coskit.project.checkpoint",json!({})).unwrap());
+    assert!(s.cancel_job(id));
+    assert_eq!(wait_event(&mut s,id).outcome,JobOutcome::Cancelled);
+    s.join_cancelled_jobs();
+    assert_eq!(s.active().unwrap().pipeline,pipeline);
+    s.execute("layer.setProps",json!({"opacity":0.5})).unwrap();
+    let id=job(s.start("coskit.project.restore",json!({"version":"v1"})).unwrap());
+    assert!(matches!(wait_event(&mut s,id).outcome,JobOutcome::Done(_)));
+    assert_eq!(pixels(&s),before);
+    assert_eq!(s.active().unwrap().pipeline.as_ref().unwrap().head.as_deref(),Some("v1"));
+}
+#[test]
+fn ckpipe_background_checkpoint_cannot_overwrite_new_conversation() {
+    let mut s=session(64,64);
+    let id=job(s.start("coskit.project.checkpoint",json!({})).unwrap());
+    let doc=s.active().unwrap().doc.id.0;
+    s.execute("coskit.project.annotate",json!({"document":doc,"messages":[{"text":"new conversation"}]})).unwrap();
+    assert!(matches!(wait_event(&mut s,id).outcome,JobOutcome::Failed(_)));
+    let p=s.active().unwrap().pipeline.as_ref().unwrap();
+    assert_eq!(p.conversations[0]["text"],"new conversation");
+    assert!(p.versions.is_empty());
+}
