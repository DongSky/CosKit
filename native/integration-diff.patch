+}
+
+fn set_resource_budget(app: &mut PhotocraftApp, gpu: &crate::gpu_canvas::GpuCanvas, allowance: u64) {
+    let usage = app.session.resource_usage();
+    let pixels = usage.pixel_history_bytes.saturating_add(usage.project_bytes)
+        .saturating_add(usage.effect_budget_bytes).saturating_add(usage.preview_budget_bytes) as u64;
     let budget = crate::gpu_canvas::memory_budget(allowance, pixels, crate::gpu_canvas::physical_memory());
     gpu.set_memory_budget(budget);
     app.perf.gpu_budget_mb = budget >> 20;
     app.perf.gpu_budget_allowance = allowance;
+}
+
+/// Metadata-only checkpoints do not redraw pixels, but still change available GPU memory.
+pub(crate) fn project_budget_changed(app: &mut PhotocraftApp) {
+    if let Some(gpu) = app.gpu.clone() {
+        let allowance = app.session.prefs().performance.history_budget_bytes() as u64;
+        set_resource_budget(app, &gpu, allowance);
+    }
 }
 
